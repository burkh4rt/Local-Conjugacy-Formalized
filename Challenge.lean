/-- Theorem 1.1, `thm:loc_conj`. Closed supplements of the pronilpotent
normal subgroup are conjugate exactly when they are locally conjugate. -/
theorem theorem_1_1 [Profinite G] (N H K : Subgroup G) [N.Normal]
    (hN : IsClosed (N : Set G)) (hH : IsClosed (H : Set G))
    (hK : IsClosed (K : Set G)) (hpron : Pronilpotent N)
    (hcase : Prosupersolvable G ∨ Pronilpotent (G ⧸ N))
    (hHN : Supplements N H) (hKN : Supplements N K) :
    Conjugate H K ↔ LocallyConjugate H K := by sorry

/-- Corollary 1.3, `thm:loc_inclusion`. -/
theorem corollary_1_3 [Profinite G] (N J H : Subgroup G)
    (hN : IsClosed (N : Set G)) (hJ : IsClosed (J : Set G))
    (hH : IsClosed (H : Set G)) (hsplit : Splits N J)
    (hpron : Pronilpotent N) (hcase : Prosupersolvable G ∨ Pronilpotent J)
    (hnormal : IntersectionNormal N H) (hlocal : LocallyContains H J) :
    ∃ g : G, conjugate g J ≤ H := by sorry

/-- Corollary 1.4, `cor:fix_pt`. No topology or continuity of the action on
`Ω` is assumed; closedness is imposed on every point stabilizer explicitly. -/
theorem corollary_1_4 [Profinite G] {Ω : Type*} [MulAction G Ω] [Nonempty Ω]
    (N J : Subgroup G) (hN : IsClosed (N : Set G)) (hJ : IsClosed (J : Set G))
    (hsplit : Splits N J) (hpron : Pronilpotent N)
    (hcase : Prosupersolvable G ∨ Pronilpotent J)
    (htrans : Transitive (G := G) (Ω := Ω))
    (hclosed : ∀ x : Ω, IsClosed (MulAction.stabilizer G x : Set G))
    (hnormal : ∃ x : Ω, IntersectionNormal N (MulAction.stabilizer G x))
    (hlocal : SylowFixedPoints (Ω := Ω) J) : HasFixedPoint (Ω := Ω) J := by sorry

/-- Proposition 3.1, `prop:comps`, with finite N as in arXiv v1. -/
theorem proposition_3_1 [Profinite G] (N H K : Subgroup G) [N.Normal] [Finite N]
    (hN : IsClosed (N : Set G)) (hH : IsClosed (H : Set G))
    (hK : IsClosed (K : Set G)) (hpron : Pronilpotent N)
    (hcase : Prosupersolvable G ∨ Pronilpotent (G ⧸ N))
    (hHN : Supplements N H) (hKN : Supplements N K)
    (hNH : N ⊓ H = ⊥) (hNK : N ⊓ K = ⊥) :
    Conjugate H K ↔ LocallyConjugate H K := by sorry

/-- Proposition 3.2, `prop:thm_main_n_nilpotent`: Theorem 1.1 for finite N. -/
theorem proposition_3_2 [Profinite G] (N H K : Subgroup G) [N.Normal] [Finite N]
    (hN : IsClosed (N : Set G)) (hH : IsClosed (H : Set G))
    (hK : IsClosed (K : Set G)) (hpron : Pronilpotent N)
    (hcase : Prosupersolvable G ∨ Pronilpotent (G ⧸ N))
    (hHN : Supplements N H) (hKN : Supplements N K) :
    Conjugate H K ↔ LocallyConjugate H K := by sorry

/-- Proposition 4.1, `thm:loc_inclusion_ab`. -/
theorem proposition_4_1 [Profinite G] (N H K : Subgroup G) [N.Normal]
    (hN : IsClosed (N : Set G)) (hH : IsClosed (H : Set G))
    (hK : IsClosed (K : Set G)) (hcomm : ∀ n m : N, n * m = m * n)
    (hHN : Supplements N H) (hKN : Supplements N K)
    (hlocal : LocallyContains H K) : ∃ g : G, conjugate g K ≤ H := by sorry

/-- Proposition 4.2, `thm:fix_pt_ab`. -/
theorem proposition_4_2 [Profinite G] {Ω : Type*} [MulAction G Ω] [Nonempty Ω]
    (N H : Subgroup G) [N.Normal] (hN : IsClosed (N : Set G))
    (hH : IsClosed (H : Set G)) (hcomm : ∀ n m : N, n * m = m * n)
    (hHN : Supplements N H) (htrans : Transitive (G := G) (Ω := Ω))
    (hclosed : ∀ x : Ω, IsClosed (MulAction.stabilizer G x : Set G))
    (hlocal : SylowFixedPoints (Ω := Ω) H) : HasFixedPoint (Ω := Ω) H := by sorry
end Main

section Cohomology
variable {J N : Type*} [Group J] [Group N]
  [TopologicalSpace J] [TopologicalSpace N] [MulDistribMulAction J N]

/-- Lemma 1.2, `lem:loc_conj`: the actual simultaneous restriction map
on H¹ is bijective, with finite nilpotent coefficient group N. -/
theorem lemma_1_2 [Profinite J] [DiscreteTopology N] [Finite N] [Group.IsNilpotent N]
    [ContinuousSMul J N]
    (hcase : Prosupersolvable (ActionProduct J N) ∨ Pronilpotent J)
    (P : PrimeDivisor J → Subgroup J) (hP : ∀ p, IsSylowPro p.val.val ⊤ (P p)) :
    Function.Bijective (primaryRestriction (N := N) P) ∧
      primaryRestriction (N := N) P default = default := by sorry

/-- Proposition 2.1, `prop:fixed_cocycle`, with locally finite discrete coefficients.
Local finiteness permits reduction to a finite invariant coefficient subgroup. -/
theorem proposition_2_1 [Profinite J] [IsTopologicalGroup N] [DiscreteTopology N]
    [ContinuousSMul J N] (hfinite : LocallyFiniteGroup N) (p p₀ : ℕ) (hp : p.Prime) (hp₀ : p₀.Prime) (hne : p₀ ≠ p)
    (hN : IsPGroup p N) (J₀ Q : Subgroup J) [J₀.Normal]
    (hJ₀ : IsClosed (J₀ : Set J)) (hQ : IsClosed (Q : Set J))
    (hcyclic : Procyclic Q) (hpro : IsProP p₀ Q)
    (f : Cocycle (N := N) J₀) (hinv : InvariantUnder Q J₀ f) :
    ∃ g : Cocycle (N := N) J₀, Cohomologous f g ∧
      (∀ (q : J) (hq : q ∈ Q) (x : J) (hx : x ∈ J₀)
        (hqx : q⁻¹ * x * q ∈ J₀),
        q • g.toFun ⟨q⁻¹ * x * q, hqx⟩ = g.toFun ⟨x, hx⟩) ∧
      ∀ (q : J) (hq : q ∈ Q) (hq₀ : q ∈ J₀), g.toFun ⟨q, hq₀⟩ = 1 := by sorry

/-- Proposition 2.2, `prop:coprime_iso`. -/
theorem proposition_2_2 [Profinite J] [IsTopologicalGroup N] [DiscreteTopology N]
    [ContinuousSMul J N] (hfinite : LocallyFiniteGroup N) (p p₀ : ℕ) (hp : p.Prime) (hp₀ : p₀.Prime) (hne : p₀ ≠ p)
    (hJ : Prosolvable J) (hN : IsPGroup p N) (J₀ : Subgroup J) [J₀.Normal]
    (hJ₀ : IsClosed (J₀ : Set J)) (hindex : J₀.index = p₀) :
    Function.Bijective (stableRestriction (N := N) J₀) := by sorry

/-- Proposition 2.3, `prop:res_pi`: restriction to any Hall subgroup for
the primes at most p bijects all cohomology classes. -/
theorem proposition_2_3 [Profinite J] [DiscreteTopology N] [Finite N]
    [ContinuousSMul J N] (p : ℕ) (hp : p.Prime) (hN : IsPGroup p N)
    (hG : Prosupersolvable (ActionProduct J N))
    (Q : Subgroup J) (hQ : IsHallPro {r | r ≤ p} Q) :
    Function.Bijective (restrictH1 (N := N) (show Q ≤ ⊤ from le_top)) := by sorry
end Cohomology

end LocalConjugacy

namespace LocalConjugacy

/-- The Introduction's Q₈ ⋊ S₃ counterexample inside GL(2,3): exactly two
classes in H¹(S₃,Q₈), trivial H¹ on every Sylow subgroup, and two actual
complements that are locally conjugate but not conjugate in the ambient group. -/
theorem counterexample_quaternion :
    ∃ a : DihedralGroup 3 →* MulAut (QuaternionGroup 2),
    Nonempty ((QuaternionGroup 2 ⋊[a] DihedralGroup 3) ≃* GL (Fin 2) (ZMod 3)) ∧
    Nat.card (FiniteH1 a) = 2 ∧
    (∀ (p : ℕ) (hp : p.Prime),
      letI : Fact p.Prime := ⟨hp⟩
      ∀ P : Sylow p (DihedralGroup 3),
        Subsingleton (FiniteH1 (a.comp P.toSubgroup.subtype))) ∧
    (let G := QuaternionGroup 2 ⋊[a] DihedralGroup 3
     letI : TopologicalSpace G := ⊥
     let N := (SemidirectProduct.rightHom : G →* DihedralGroup 3).ker
     let J := (SemidirectProduct.inr : DihedralGroup 3 →* G).range
     ∃ J' : Subgroup G, Splits N J ∧ Splits N J' ∧
       LocallyConjugate J J' ∧ ¬ Conjugate J J') := by
  sorry

/-- The order-162 counterexample to local inclusion without the normality
of `N ∩ H` in `N`. In the construction, `G = C₃ wr S₃`, `|N| = 27`,
`J` is cyclic of order 6, and `H ≃ C₃ × S₃` has order 18. -/
theorem counterexample_heisenberg :
    ∃ (G : ProfiniteGrp.{0}) (N J H : Subgroup G),
    Finite G ∧ Nonempty (G ≃* WreathC3S3) ∧ Nonempty (N ≃* Heisenberg3) ∧
    Nonempty (J ≃* Multiplicative (ZMod 6)) ∧
    Group.IsNilpotent N ∧ Group.IsNilpotent J ∧ Nat.card G = 162 ∧ Nat.card N = 27 ∧ Nat.card J = 6 ∧ Nat.card H = 18 ∧
    Nonempty (H ≃* Multiplicative (ZMod 3) × DihedralGroup 3) ∧
    Splits N J ∧ Pronilpotent N ∧ Pronilpotent J ∧ Supersolvable G ∧ IsCyclic J ∧
    (∀ n : N, n ^ 3 = 1) ∧ (¬ ∀ n m : N, n * m = m * n) ∧
    IsClosed (N : Set G) ∧ IsClosed (J : Set G) ∧ IsClosed (H : Set G) ∧
    LocallyContains H J ∧ (¬ ∃ g : G, conjugate g J ≤ H) ∧
    ¬ IntersectionNormal N H := by
  sorry

end LocalConjugacy
