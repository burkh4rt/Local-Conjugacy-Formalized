module

public import LocalConjugacy.FiniteConjugacyTools

@[expose] public section

namespace LocalConjugacy

variable {G : Type*} [Group G] [Finite G] [TopologicalSpace G] [DiscreteTopology G]

theorem sylowPro_relIndex_not_dvd {p : ℕ} [Fact p.Prime]
    {H P : Subgroup G} (hP : IsSylowPro p H P) : ¬ p ∣ P.relIndex H := by
  letI : Profinite G := ⟨⟩
  obtain ⟨S, hS⟩ := sylow_of_isSylowPro (P.subgroupOf H)
    (isSylowPro_subgroupOf H P (isClosed_discrete _) hP)
  change ¬ p ∣ (P.subgroupOf H).index
  rw [← hS]
  exact S.not_dvd_index

theorem isSylowPro_in_subgroup {p : ℕ} [Fact p.Prime]
    {H P L : Subgroup G} (hP : IsSylowPro p H P) (hHL : H ≤ L) :
    IsSylowPro p (H.subgroupOf L) (P.subgroupOf L) := by
  apply isSylowPro_of_index (H.subgroupOf L) (P.subgroupOf L) (fun _ hx => hP.1 hx)
  · exact ((isProP_iff_isPGroup p).mp hP.2.2.1).comap_subtype
  · change ¬ p ∣ (P.subgroupOf L).relIndex (H.subgroupOf L)
    rw [Subgroup.relIndex_subgroupOf hHL]
    exact sylowPro_relIndex_not_dvd hP

theorem sylowPro_top_of_not_dvd_index {p : ℕ} [hp : Fact p.Prime]
    {H P : Subgroup G} (hP : IsSylowPro p H P) (hH : ¬ p ∣ H.index) :
    IsSylowPro p ⊤ P := by
  apply isSylowPro_of_index _ _ le_top ((isProP_iff_isPGroup p).mp hP.2.2.1)
  change ¬ p ∣ P.relIndex ⊤
  rw [Subgroup.relIndex_top_right, ← Subgroup.relIndex_mul_index hP.1]
  exact fun hd => (hp.out.dvd_mul.mp hd).elim (sylowPro_relIndex_not_dvd hP) hH

theorem sylowPro_top_of_pGroup_supplement (N H P : Subgroup G) [N.Normal]
    {p q : ℕ} [Fact p.Prime] [hq : Fact q.Prime] (hne : q ≠ p)
    (hN : IsPGroup p N) (hs : Supplements N H) (hP : IsSylowPro q H P) :
    IsSylowPro q ⊤ P := by
  apply sylowPro_top_of_not_dvd_index hP
  intro hd
  obtain ⟨k, hk⟩ := hN.exists_card_eq
  have hdiv : q ∣ p ^ k := hk ▸ hd.trans (index_dvd_card_of_supplements N H hs)
  exact hne ((Nat.prime_dvd_prime_iff_eq hq.out Fact.out).mp (hq.out.dvd_of_dvd_pow hdiv))

/-- A normal p-subgroup meets a subgroup inside every one of its Sylows. -/
theorem inf_eq_inf_sylowPro (N H P : Subgroup G) [N.Normal]
    {p : ℕ} [Fact p.Prime] (hN : IsPGroup p N) (hP : IsSylowPro p H P) :
    N ⊓ P = N ⊓ H := by
  letI : Profinite G := ⟨⟩
  obtain ⟨S, hS⟩ := sylow_of_isSylowPro (P.subgroupOf H)
    (isSylowPro_subgroupOf H P (isClosed_discrete _) hP)
  have hle := (hN.comap_subtype (K := H)).le_sylow_of_normal S
  rw [hS] at hle
  apply le_antisymm (inf_le_inf_left N hP.1)
  intro x hx
  exact ⟨hx.1, hle (show (⟨x, hx.2⟩ : H) ∈ N.subgroupOf H from hx.1)⟩

/-- After the common Sylow is aligned, the two intersections coincide and
are normal in the subgroup generated by the supplements. -/
theorem normal_inf_of_common_sylow (N H K P : Subgroup G) [N.Normal]
    {p : ℕ} [Fact p.Prime] (hN : IsPGroup p N)
    (hPH : IsSylowPro p H P) (hPK : IsSylowPro p K P) (hgen : H ⊔ K = ⊤) :
    N ⊓ H = N ⊓ K ∧ (N ⊓ H).Normal := by
  have he : N ⊓ H = N ⊓ K :=
    (inf_eq_inf_sylowPro N H P hN hPH).symm.trans (inf_eq_inf_sylowPro N K P hN hPK)
  refine ⟨he, Subgroup.normalizer_eq_top_iff.mp ?_⟩
  apply top_unique
  rw [← hgen]
  apply sup_le
  · apply (Subgroup.normal_subgroupOf_iff_le_normalizer inf_le_right).mp
    simpa only [Subgroup.inf_subgroupOf_right] using
      (inferInstance : (N.subgroupOf H).Normal)
  · rw [he]
    apply (Subgroup.normal_subgroupOf_iff_le_normalizer inf_le_right).mp
    simpa only [Subgroup.inf_subgroupOf_right] using
      (inferInstance : (N.subgroupOf K).Normal)

/-- Local conjugacy remains valid inside the generated subgroup in the
p-group case: away from p the Sylows are Sylows of the ambient group. -/
theorem locallyConjugate_generated_of_common_sylow (N H K P : Subgroup G) [N.Normal]
    {p : ℕ} [Fact p.Prime] (hN : IsPGroup p N)
    (hsH : Supplements N H) (hsK : Supplements N K)
    (hPH : IsSylowPro p H P) (hPK : IsSylowPro p K P) :
    LocallyConjugate (H.subgroupOf (H ⊔ K)) (K.subgroupOf (H ⊔ K)) := by
  letI : Profinite G := ⟨⟩
  let L := H ⊔ K
  letI : Profinite L := ⟨⟩
  intro q hq
  letI : Fact q.Prime := ⟨hq⟩
  by_cases he : q = p
  · subst q
    exact ⟨P.subgroupOf L, P.subgroupOf L,
      isSylowPro_in_subgroup hPH le_sup_left, isSylowPro_in_subgroup hPK le_sup_right,
      1, conjugate_one _⟩
  · obtain ⟨A, hA⟩ := exists_sylowPro_subgroup q H (isClosed_discrete _)
    obtain ⟨B, hB⟩ := exists_sylowPro_subgroup q K (isClosed_discrete _)
    have hAG := sylowPro_top_of_pGroup_supplement N H A he hN hsH hA
    have hBG := sylowPro_top_of_pGroup_supplement N K B he hN hsK hB
    have hAL := isSylowPro_subgroupOf L A (isClosed_discrete _)
      (isSylowPro_of_intermediate hAG (hA.1.trans le_sup_left) le_top)
    have hBL := isSylowPro_subgroupOf L B (isClosed_discrete _)
      (isSylowPro_of_intermediate hBG (hB.1.trans le_sup_right) le_top)
    exact ⟨A.subgroupOf L, B.subgroupOf L, isSylowPro_in_subgroup hA le_sup_left,
      isSylowPro_in_subgroup hB le_sup_right, sylowPro_conjugate _ _ hAL hBL⟩

end LocalConjugacy
